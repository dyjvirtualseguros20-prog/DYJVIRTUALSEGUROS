# ═════════════════════════════════════════════════════════════════════════════
#  CONFIGURACIÓN DE LA WEB
#  Copia este archivo con el nombre .env.local y completa los valores.
#  .env.local es privado: no lo subas a internet.
# ═════════════════════════════════════════════════════════════════════════════

# Dirección pública de la web (para Google y redes sociales).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Dónde encontrarlas: Supabase → tu proyecto → Project Settings → API Keys.
# Las dos son PÚBLICAS: no pasa nada si alguien las ve, porque la base de datos
# está protegida con Row Level Security. NO hace falta ninguna clave secreta.

# 1) Dirección del proyecto (Project URL). Ejemplo: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 2) Clave pública → "Publishable key" (empieza por sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── ACCESO DE PRUEBA (solo mientras NO haya Supabase) ───────────────────────
# Cuando completes las 2 variables de arriba, esto deja de usarse.
ADMIN_DEV_EMAIL=asesor@localhost
ADMIN_DEV_PASSWORD=

# ─── ASESOR VIRTUAL CON IA (Anthropic · Claude Haiku 4.5) ───────────────────
# Clave SECRETA de la API de Anthropic (console.anthropic.com → API Keys).
# Va solo en el servidor: nunca en el navegador ni en GitHub.
# En Cloudflare se guarda como "Secret" (no como variable de texto).
# Sin esta clave, en producción el botón del asesor virtual no aparece.
ANTHROPIC_API_KEY=
# Opcional: otro modelo (por defecto claude-haiku-4-5-20251001).
ANTHROPIC_MODEL=
# Solo desarrollo: 1 = respuestas de prueba sin IA (para probar el chat sin clave).
ASSISTANT_MOCK=

# ─── Cotizaciones automáticas con aseguradoras (futuro, no tocar) ────────────
NEXT_PUBLIC_QUOTES_SOURCE=mock
QUOTES_API_URL=
QUOTES_API_KEY=
